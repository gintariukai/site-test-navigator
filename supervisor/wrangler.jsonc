{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-test-navigator-supervisor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_REPOSITORY": "gintariukai/site-test-navigator",
    "OPENAI_MODEL": "gpt-5-mini"
  },
  "d1_databases": [
    {
      "binding": "IDEMPOTENCY_DB",
      "database_name": "site-test-navigator-supervisor",
      "database_id": "d6a1a9bd-d302-49e0-917e-ec9700ebe7be",
      "migrations_dir": "migrations"
    }
  ]
}
